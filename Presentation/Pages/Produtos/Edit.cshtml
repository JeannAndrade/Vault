@page "{id:guid}"
@model EditModel
@{
  ViewData["Title"] = "Editar produto";
}

<div class="row justify-content-center"><div class="col-lg-9 col-xl-8">
  <h1 class="h3 mb-3">Editar produto</h1>
  @if (Model.ErrorMessage is not null) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
  <form method="post"><div class="card shadow-sm">
    <div class="card-body p-4"><p class="text-muted small mb-3"><span class="text-danger">*</span> campo obrigatório</p>
      <div><label asp-for="Input.Nome" class="form-label">Nome <span class="text-danger" aria-hidden="true">*</span></label>
        <input asp-for="Input.Nome" class="form-control" maxlength="100" required autofocus /><span asp-validation-for="Input.Nome" class="text-danger small"></span></div>
    </div><div class="card-footer bg-body-tertiary d-flex justify-content-end gap-2 py-3"><a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a><button type="submit" class="btn btn-primary">Salvar</button></div>
  </div></form>
</div></div>
