@page
@model IndexModel
@{
  ViewData["Title"] = "Corretoras";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Corretoras</h1>
  <a class="btn btn-primary btn-sm" asp-page="Create">
    <i class="bi bi-plus-lg me-1"></i>Nova corretora
  </a>
</div>

@if (Model.ErrorMessage is not null)
{
  <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@* ---------- Card de Resultados ---------- *@
<div class="card shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
    <h2 class="h6 mb-0">
      <i class="bi bi-table me-1"></i>Corretoras
      <span class="text-muted fw-normal ms-1">(@Model.Corretoras.Count)</span>
    </h2>
  </div>

  @if (Model.Corretoras.Count == 0)
  {
    <div class="card-body text-center py-5">
      <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
      <p class="text-muted mt-2 mb-0">Nenhuma corretora cadastrada ainda.</p>
      <a class="btn btn-primary btn-sm mt-3" asp-page="Create">
        <i class="bi bi-plus-lg me-1"></i>Cadastrar primeira corretora
      </a>
    </div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Nome</th>
            <th class="text-end" style="width: 14rem">Ações</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var corretora in Model.Corretoras)
          {
            <tr>
              <td class="fw-medium">@corretora.Nome</td>
              <td class="text-end text-nowrap">
                <div class="d-inline-flex gap-1">
                  <a class="btn btn-outline-secondary btn-sm" asp-page="Edit" asp-route-id="@corretora.Id">Editar</a>
                  <form method="post" asp-page-handler="Delete" asp-route-id="@corretora.Id" class="d-inline-flex mb-0"
                        onsubmit="return confirm('Excluir esta corretora?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Excluir</button>
                  </form>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>