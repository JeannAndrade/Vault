@page
@model IndexModel
@{
  ViewData["Title"] = "Corretoras";
}

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Corretoras</h1>
  <a class="btn btn-primary btn-sm" asp-page="Create">Nova corretora</a>
</div>

@if (Model.Corretoras.Count == 0)
{
  <p class="text-muted">Nenhuma corretora cadastrada.</p>
}
else
{
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Nome</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var corretora in Model.Corretoras)
      {
        <tr>
          <td>@corretora.Nome</td>
          <td class="text-end">
            <a class="btn btn-outline-secondary btn-sm" asp-page="Edit" asp-route-id="@corretora.Id">Editar</a>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
