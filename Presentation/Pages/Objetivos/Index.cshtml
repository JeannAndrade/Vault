@page
@using System.Globalization
@model IndexModel
@{
    ViewData["Title"] = "Objetivos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Objetivos</h1>
    <a class="btn btn-primary btn-sm" asp-page="Create">
        <i class="bi bi-plus-lg me-1"></i>Novo objetivo
    </a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <h2 class="h6 mb-0">
            <i class="bi bi-table me-1"></i>Resultados
            <span class="text-muted fw-normal ms-1">(@Model.Objetivos.Count)</span>
        </h2>
    </div>

    @if (Model.Objetivos.Count == 0)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
            <p class="text-muted mt-2 mb-0">Nenhum objetivo cadastrado.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome</th>
                        <th class="text-end">Meta</th>
                        <th class="text-end">Aporte mensal</th>
                        <th>Fonte pagadora</th>
                        <th>Onde aplicar</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var objetivo in Model.Objetivos)
                    {
                        <tr>
                            <td class="fw-medium">
                                @objetivo.Nome
                                @if (!string.IsNullOrWhiteSpace(objetivo.Descricao))
                                {
                                    <div class="small text-muted fw-normal">@objetivo.Descricao</div>
                                }
                            </td>
                            <td class="text-end">@objetivo.Meta.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td>
                            <td class="text-end">@objetivo.AporteMensal.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td>
                            <td>@objetivo.FontePagadora</td>
                            <td>@objetivo.OndeAplicar</td>
                            <td>@(objetivo.EstaAtivo ? "Ativo" : "Inativo")</td>
                            <td class="text-end text-nowrap">
                                <div class="d-inline-flex gap-1">
                                    <a class="btn btn-outline-secondary btn-sm" asp-page="Edit"
                                       asp-route-id="@objetivo.Id">Editar</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@objetivo.Id"
                                          class="mb-0"
                                          onsubmit="return confirm('Excluir este objetivo?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Excluir</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
