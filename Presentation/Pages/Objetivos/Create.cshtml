@page
@model CreateModel
@{
  ViewData["Title"] = "Novo objetivo";
}

<div class="row justify-content-center">
  <div class="col-lg-9 col-xl-8">
    <h1 class="h3 mb-3">Novo objetivo</h1>

    @if (Model.ErrorMessage is not null)
    {
      <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <p class="text-muted small mb-3"><span class="text-danger">*</span> campo obrigatório</p>
          <partial name="_ObjetivoForm" for="Input" />
        </div>
        <div class="card-footer bg-body-tertiary d-flex justify-content-end gap-2 py-3">
          <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
          <button type="submit" class="btn btn-primary">Salvar</button>
        </div>
      </div>
    </form>
  </div>
</div>
