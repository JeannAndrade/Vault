@page
@model Presentation.Pages.Dashboards.ConsolidadoModel
@using System.Globalization
@using Presentation.Dashboards
@{
    ViewData["Title"] = "Consolidado";
    var cultura = CultureInfo.GetCultureInfo("pt-BR");
    var filtroAtivo = Model.Filtro.HasValue || Model.AgruparPor is not null;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Consolidado</h1>
</div>

@* ---------- Card de Filtros ---------- *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <h2 class="h6 mb-0">
            <i class="bi bi-funnel me-1"></i>Filtros
            @if (filtroAtivo)
            {
                <span class="badge bg-primary-subtle text-primary-emphasis ms-2">Ativos</span>
            }
        </h2>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-6 col-md-3">
                <label asp-for="Filtro.TipoRendaId" class="form-label small text-muted">Tipo de Renda</label>
                <select asp-for="Filtro.TipoRendaId" asp-items="Model.Lookup.TiposRenda"
                        class="form-select form-select-sm">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="Filtro.CorretoraId" class="form-label small text-muted">Corretora</label>
                <select asp-for="Filtro.CorretoraId" asp-items="Model.Lookup.Corretoras"
                        class="form-select form-select-sm">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="Filtro.ProdutoId" class="form-label small text-muted">Produto</label>
                <select asp-for="Filtro.ProdutoId" asp-items="Model.Lookup.Produtos" class="form-select form-select-sm">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="Filtro.EmissorId" class="form-label small text-muted">Emissor</label>
                <select asp-for="Filtro.EmissorId" asp-items="Model.Lookup.Emissores"
                        class="form-select form-select-sm">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="AgruparPor" class="form-label small text-muted">Agrupar por</label>
                <select asp-for="AgruparPor" class="form-select form-select-sm">
                    <option value="">Sem agrupamento</option>
                    <option value="TipoRenda">Tipo de Renda</option>
                    <option value="Corretora">Corretora</option>
                    <option value="Produto">Produto</option>
                    <option value="Emissor">Emissor</option>
                </select>
            </div>
            <div class="col-12 d-flex gap-2 pt-1">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Dashboards/Consolidado">
                    <i class="bi bi-x-lg me-1"></i>Limpar
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@* ---------- Card de Resultados ---------- *@
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <h2 class="h6 mb-0">
            <i class="bi bi-table me-1"></i>Resultados
            @if (Model.Resultado is not null)
            {
                <span class="text-muted fw-normal ms-1">(@Model.Resultado.Total.Quantidade)</span>
            }
        </h2>
    </div>

    @if (!Model.TemCriterio)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-sliders text-muted" style="font-size: 2.5rem;"></i>
            <p class="text-muted mt-2 mb-0">
                Escolha ao menos um filtro ou um agrupamento e clique em <strong>Filtrar</strong>.
            </p>
        </div>
    }
    else if (Model.Resultado is { Total.Quantidade: 0 })
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
            <p class="text-muted mt-2 mb-0">
                Nenhum movimento ativo encontrado para os critérios selecionados.
            </p>
            <a class="btn btn-outline-secondary btn-sm mt-3" asp-page="/Dashboards/Consolidado">
                Limpar filtros
            </a>
        </div>
    }
    else if (Model.Resultado is not null && Model.TemGrupos)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@ConsolidadoFormatter.RotuloDimensao(Model.AgruparPor)</th>
                        <th class="text-end">Qtde Movimentos</th>
                        <th class="text-end">Total Aportado</th>
                        <th class="text-end">Total Líquido</th>
                        <th class="text-end">% do Total Líquido</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grupo in Model.Resultado.Grupos)
                    {
                        <tr>
                            <td class="fw-medium">@ConsolidadoFormatter.NomeDoGrupo(grupo.Nome)</td>
                            <td class="text-end">@grupo.Quantidade</td>
                            <td class="text-end">@grupo.TotalAportado.ToString("C", cultura)</td>
                            <td class="text-end fw-medium">@grupo.TotalLiquido.ToString("C", cultura)</td>
                            <td class="text-end">
                                @ConsolidadoFormatter.Percentual(grupo.PercentualLiquido)
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-group-divider">
                    <tr class="fw-semibold">
                        <th>Total</th>
                        <th class="text-end">@Model.Resultado.Total.Quantidade</th>
                        <th class="text-end">
                            @Model.Resultado.Total.TotalAportado.ToString("C", cultura)
                        </th>
                        <th class="text-end">
                            @Model.Resultado.Total.TotalLiquido.ToString("C", cultura)
                        </th>
                        <th class="text-end">
                            @ConsolidadoFormatter.Percentual(Model.Resultado.Total.PercentualLiquido)
                        </th>
                    </tr>
                </tfoot>
            </table>
        </div>

        @* Notas explicativas no rodapé do card, sem competir com o conteúdo *@
        <div class="card-footer bg-white py-2">
            <p class="text-muted small mb-1">
                <i class="bi bi-info-circle me-1"></i>
                Considera apenas Movimentos ativos. Movimentos encerrados como <strong>Pendente</strong> não entram:
                o dinheiro pode já ter sido levado para outro lugar.
            </p>
            <p class="text-muted small mb-0">
                <i class="bi bi-info-circle me-1"></i>
                Movimentos de Objetivos inativos entram. Por isso o total pode ser diferente do total
                da tela inicial, que lista só Objetivos ativos e inclui Pendente.
            </p>
        </div>
    }
    else if (Model.Resultado is not null)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-end">Qtde Movimentos</th>
                        <th class="text-end">Total Aportado</th>
                        <th class="text-end">Total Líquido</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-end">@Model.Resultado.Total.Quantidade</td>
                        <td class="text-end">
                            @Model.Resultado.Total.TotalAportado.ToString("C", cultura)
                        </td>
                        <td class="text-end fw-medium">
                            @Model.Resultado.Total.TotalLiquido.ToString("C", cultura)
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-2">
            <p class="text-muted small mb-1">
                <i class="bi bi-info-circle me-1"></i>
                Considera apenas Movimentos ativos. Movimentos encerrados como <strong>Pendente</strong> não entram:
                o dinheiro pode já ter sido levado para outro lugar.
            </p>
            <p class="text-muted small mb-0">
                <i class="bi bi-info-circle me-1"></i>
                Movimentos de Objetivos inativos entram. Por isso o total pode ser diferente do total
                da tela inicial, que lista só Objetivos ativos e inclui Pendente.
            </p>
        </div>
    }
</div>
