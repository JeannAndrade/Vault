@page
@model IndexModel
@{
  ViewData["Title"] = "Tipo de Renda";
}

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Tipos de Renda</h1>
  <a class="btn btn-primary btn-sm" asp-page="Create">Novo tipo de renda</a>
</div>

@if (Model.ErrorMessage is not null)
{
  <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.TiposRenda.Count == 0)
{
  <p class="text-muted">Nenhum tipo de renda cadastrado.</p>
}
else
{
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Nome</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var tipoRenda in Model.TiposRenda)
      {
        <tr>
          <td>@tipoRenda.Nome</td>
          <td class="text-end">
            <a class="btn btn-outline-secondary btn-sm" asp-page="Edit" asp-route-id="@tipoRenda.Id">Editar</a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@tipoRenda.Id" class="d-inline"
                  onsubmit="return confirm('Excluir este tipo de renda?');">
              <button type="submit" class="btn btn-outline-danger btn-sm">Excluir</button>
            </form>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
