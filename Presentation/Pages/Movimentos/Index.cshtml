@page
@model IndexModel
@using Presentation.Movimentos
@{
    ViewData["Title"] = "Movimentos";
    var filtroAtivo = Model.Filtro.HasValue;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Movimentos</h1>
    <a class="btn btn-primary btn-sm" asp-page="Create" asp-route-pagina="@Model.Pagina"
       asp-route-Filtro.ObjetivoId="@Model.Filtro.ObjetivoId" asp-route-Filtro.TipoRendaId="@Model.Filtro.TipoRendaId"
       asp-route-Filtro.CorretoraId="@Model.Filtro.CorretoraId" asp-route-Filtro.ProdutoId="@Model.Filtro.ProdutoId"
       asp-route-Filtro.EmissorId="@Model.Filtro.EmissorId" asp-route-Filtro.EstaAtivo="@Model.Filtro.EstaAtivo">
        <i class="bi bi-plus-lg me-1"></i>Novo movimento
    </a>
</div>

@* ---------- Card de Filtros ---------- *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <h2 class="h6 mb-0">
            <i class="bi bi-funnel me-1"></i>Filtros
            @if (filtroAtivo)
            {
                <span class="badge bg-primary-subtle text-primary-emphasis ms-2">Ativos</span>
            }
        </h2>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-6 col-md-2">
                <label asp-for="Filtro.ObjetivoId" class="form-label small text-muted">Objetivo</label>
                <select asp-for="Filtro.ObjetivoId" asp-items="Model.Lookup.Objetivos"
                        class="form-select form-select-sm">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="Filtro.TipoRendaId" class="form-label small text-muted">Tipo de Renda</label>
                <select asp-for="Filtro.TipoRendaId" asp-items="Model.Lookup.TiposRenda"
                        class="form-select form-select-sm">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="Filtro.CorretoraId" class="form-label small text-muted">Corretora</label>
                <select asp-for="Filtro.CorretoraId" asp-items="Model.Lookup.Corretoras"
                        class="form-select form-select-sm">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="Filtro.ProdutoId" class="form-label small text-muted">Produto</label>
                <select asp-for="Filtro.ProdutoId" asp-items="Model.Lookup.Produtos" class="form-select form-select-sm">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="Filtro.EmissorId" class="form-label small text-muted">Emissor</label>
                <select asp-for="Filtro.EmissorId" asp-items="Model.Lookup.Emissores"
                        class="form-select form-select-sm">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="Filtro.EstaAtivo" class="form-label small text-muted">Status</label>
                <select asp-for="Filtro.EstaAtivo" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="true">Ativos</option>
                    <option value="false">Inativos</option>
                </select>
            </div>
            <div class="col-12 d-flex gap-2 pt-1">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Movimentos/Index">
                    <i class="bi bi-x-lg me-1"></i>Limpar
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@* ---------- Card de Resultados ---------- *@
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <h2 class="h6 mb-0">
            <i class="bi bi-table me-1"></i>Resultados
            <span class="text-muted fw-normal ms-1">(@Model.Resultado.TotalCount)</span>
        </h2>
        @if (Model.Resultado.TotalPages > 1)
        {
            <span class="text-muted small">
                Página @Model.Resultado.Page de @Model.Resultado.TotalPages
            </span>
        }
    </div>

    @if (Model.Movimentos.Count == 0)
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
            <p class="text-muted mt-2 mb-0">
                @(filtroAtivo
                    ? "Nenhum movimento encontrado com os filtros selecionados."
                    : "Nenhum movimento cadastrado ainda.")
            </p>
            @if (filtroAtivo)
            {
                <a class="btn btn-outline-secondary btn-sm mt-3" asp-page="/Movimentos/Index">
                    Limpar filtros
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 2.5rem"></th>
                        <th>Objetivo</th>
                        <th>Tipo de Renda</th>
                        <th>Corretora</th>
                        <th>Produto</th>
                        <th>Emissor</th>
                        <th>Vencimento</th>
                        <th class="text-end">Valor Líquido</th>
                        <th class="text-end" style="width: 16rem">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movimento in Model.Movimentos)
                    {
                        var detalheId = $"detalhe-{movimento.Id}";

                        <tr class="@(movimento.EstaAtivo ? "" : "opacity-50")">
                            <td>
                                <button type="button" class="btn btn-link p-0 text-body" data-bs-toggle="collapse"
                                        data-bs-target="#@detalheId" aria-controls="@detalheId" aria-expanded="false"
                                        aria-label="Exibir detalhes do movimento">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </td>
                            <td class="fw-medium">@movimento.ObjetivoNome</td>
                            <td>@movimento.TipoRendaNome</td>
                            <td>@movimento.CorretoraNome</td>
                            <td>@movimento.ProdutoNome</td>
                            <td>@movimento.EmissorNome</td>
                            <td>@(movimento.DataVencimento?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-end fw-medium">
                                @movimento.ValorLiquidoAtual.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                            </td>
                            <td class="text-end text-nowrap">
                                <div class="d-inline-flex gap-1">
                                    <a class="btn btn-outline-secondary btn-sm" asp-page="Edit" asp-route-id="@movimento.Id"
                                       asp-route-pagina="@Model.Pagina" asp-route-Filtro.ObjetivoId="@Model.Filtro.ObjetivoId"
                                       asp-route-Filtro.TipoRendaId="@Model.Filtro.TipoRendaId"
                                       asp-route-Filtro.CorretoraId="@Model.Filtro.CorretoraId"
                                       asp-route-Filtro.ProdutoId="@Model.Filtro.ProdutoId"
                                       asp-route-Filtro.EmissorId="@Model.Filtro.EmissorId"
                                       asp-route-Filtro.EstaAtivo="@Model.Filtro.EstaAtivo">Editar</a>
                                    <a class="btn btn-outline-primary btn-sm" asp-page="Encerrar" asp-route-id="@movimento.Id"
                                       asp-route-pagina="@Model.Pagina" asp-route-Filtro.ObjetivoId="@Model.Filtro.ObjetivoId"
                                       asp-route-Filtro.TipoRendaId="@Model.Filtro.TipoRendaId"
                                       asp-route-Filtro.CorretoraId="@Model.Filtro.CorretoraId"
                                       asp-route-Filtro.ProdutoId="@Model.Filtro.ProdutoId"
                                       asp-route-Filtro.EmissorId="@Model.Filtro.EmissorId"
                                       asp-route-Filtro.EstaAtivo="@Model.Filtro.EstaAtivo">@(movimento.EstaAtivo ? "Encerrar"                               : "Reclassificar")</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@movimento.Id"
                                          asp-route-pagina="@Model.Pagina" asp-route-Filtro.ObjetivoId="@Model.Filtro.ObjetivoId"
                                          asp-route-Filtro.TipoRendaId="@Model.Filtro.TipoRendaId"
                                          asp-route-Filtro.CorretoraId="@Model.Filtro.CorretoraId"
                                          asp-route-Filtro.ProdutoId="@Model.Filtro.ProdutoId"
                                          asp-route-Filtro.EmissorId="@Model.Filtro.EmissorId"
                                          asp-route-Filtro.EstaAtivo="@Model.Filtro.EstaAtivo" class="d-inline-flex mb-0"
                                          onsubmit="return confirm('Excluir este movimento?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Excluir</button>
                                    </form>
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="9" class="p-0">
                                <div class="collapse" id="@detalheId">
                                    <div class="p-3 bg-body-tertiary border-top">
                                        <dl class="row mb-0 small">
                                            <dt class="col-sm-3 text-muted fw-normal">Data do investimento</dt>
                                            <dd class="col-sm-3">@movimento.DataInvestimento.ToString("dd/MM/yyyy")</dd>

                                            <dt class="col-sm-3 text-muted fw-normal">Valor do aporte</dt>
                                            <dd class="col-sm-3">@movimento.ValorAporte.ToString("C", new
                                                                                                                                        System.Globalization.CultureInfo("pt-BR"))</dd>

                                                <dt class="col-sm-3 text-muted fw-normal">Rentabilidade contratada</dt>
                                                <dd class="col-sm-3">@(movimento.RentabilidadeContratada ?? "—")</dd>

                                                <dt class="col-sm-3 text-muted fw-normal">Cotação na compra</dt>
                                                <dd class="col-sm-3">@(movimento.CotacaoNaCompra ?? "—")</dd>

                                                <dt class="col-sm-3 text-muted fw-normal">Quantidade</dt>
                                                <dd class="col-sm-3">@(movimento.Quantidade?.ToString("N2", new
                                                                                                                                                System.Globalization.CultureInfo("pt-BR")) ?? "—")</dd>

                                                    <dt class="col-sm-3 text-muted fw-normal">Protocolo</dt>
                                                    <dd class="col-sm-3">@(movimento.Protocolo ?? "—")</dd>

                                                    <dt class="col-sm-3 text-muted fw-normal">Reinvestimento</dt>
                                                    <dd class="col-sm-3">@(movimento.EhReinvestimento ? "Sim" : "Não")</dd>

                                                    <dt class="col-sm-3 text-muted fw-normal">Status</dt>
                                                    <dd class="col-sm-3">
                                                        <span
                                                            class="badge @(movimento.EstaAtivo ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                                            @(movimento.EstaAtivo ? "Ativo" : "Encerrado")
                                                        </span>
                                                    </dd>

                                                    <dt class="col-sm-3 text-muted fw-normal">Varia por cotação</dt>
                                                    <dd class="col-sm-3">@(movimento.AtualizaPorCotacao ? "Sim" : "Não")</dd>

                                                    @if (!movimento.EstaAtivo)
                                                    {
                                                        <dt class="col-sm-3 text-muted fw-normal">Motivo do encerramento</dt>
                                                        <dd class="col-sm-3">
                                                            @MotivoEncerramentoFormatter.Descricao(movimento.MotivoEncerramento)</dd>

                                                            <dt class="col-sm-3 text-muted fw-normal">Data do encerramento</dt>
                                                            <dd class="col-sm-3">@(movimento.DataEncerramento?.ToString("dd/MM/yyyy") ?? "—")
                                                            </dd>
                                                        }

                                                        <dt class="col-sm-3 text-muted fw-normal">Observação</dt>
                                                        <dd class="col-sm-9">@(movimento.Observacao ?? "—")</dd>
                                                    </dl>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">
                            @Model.Resultado.TotalCount movimento(s)
                        </span>
                        <lumia-pagination page="Model.Resultado.Page" total-pages="Model.Resultado.TotalPages" />
                    </div>
                }
            </div>
