@page
@model Presentation.Pages.Movimentos.AtualizacaoPorCotacaoModel
@using Presentation.Cotacoes

@{
    ViewData["Title"] = "Atualização por Cotação";
    const string semCotacao = "sem cotação";
}

<h1 class="h3">Atualização por Cotação</h1>
<p>
    A cotação mais recente recalcula os movimentos ativos marcados para variar por cotação. Uma data anterior grava apenas o histórico.
</p>

@if (Model.MensagemSucesso is not null)
{
    <div class="alert alert-success">@Model.MensagemSucesso</div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!Model.Papeis.Any())
{
    <p class="text-muted">Nenhum movimento com valor por cotação.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Papel</th>
                <th>Última cotação</th>
                <th>Data</th>
                <th>Atualizar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var papel in Model.Papeis)
            {
                var ultimoValorFormatado = papel.UltimoValor is null
                    ? semCotacao
                    : CotacaoFormatter.Formatar(papel.UltimoValor.Value);

                var dataUltimaCotacao = papel.DataUltimaCotacao?.ToString("dd/MM/yyyy") ?? semCotacao;

                <tr>
                    <td>@papel.Papel</td>
                    <td>@ultimoValorFormatado</td>
                    <td>@dataUltimaCotacao</td>
                    <td>
                        <form method="post" asp-page-handler="Atualizar" asp-route-papel="@papel.Papel" class="row g-1">
                            <div class="col">
                                <input name="Input.Valor" id="valor-@papel.Papel" class="form-control" type="number" step="0.0001" min="0.0001" required />
                            </div>
                            <div class="col">
                                <input name="Input.Data" class="form-control" type="date" value="@Model.Hoje.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-primary" type="submit">Atualizar</button>
                            </div>
                        </form>

                        @if (Model.PapelComErro == papel.Papel)
                        {
                            <span class="text-danger">Informe valores válidos e uma data não futura.</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
