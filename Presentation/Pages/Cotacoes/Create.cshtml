@page
@model Presentation.Pages.Cotacoes.CreateModel

@{
    ViewData["Title"] = "Nova cotação";
}

<div class="row justify-content-center"><div class="col-lg-9 col-xl-8"><h1 class="h3 mb-3">Nova cotação</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post"><div class="card shadow-sm"><div class="card-body p-4"><p class="text-muted small mb-3"><span class="text-danger">*</span> campo obrigatório</p>
    <input asp-for="Pagina" type="hidden" />
    <input asp-for="PapelFiltro" type="hidden" />

    <div class="mb-3">
    <label asp-for="Input.Papel" class="form-label">Papel <span class="text-danger">*</span></label>
        <input asp-for="Input.Papel" class="form-control" list="papeis" required autofocus />
        <datalist id="papeis">
            @foreach (var papel in Model.Papeis)
            {
                <option value="@papel"></option>
            }
        </datalist>
        <span asp-validation-for="Input.Papel" class="text-danger"></span>
    </div>

    <div class="mb-3">
    <label asp-for="Input.Valor" class="form-label">Valor <span class="text-danger">*</span></label>
        <input asp-for="Input.Valor" class="form-control text-end" type="number" step="0.0001" min="0.0001" required />
        <span asp-validation-for="Input.Valor" class="text-danger"></span>
    </div>

    <div class="mb-3">
    <label asp-for="Input.Data" class="form-label">Data <span class="text-danger">*</span></label>
        <input asp-for="Input.Data" class="form-control" type="date" required />
        <span asp-validation-for="Input.Data" class="text-danger"></span>
    </div>

    </div><div class="card-footer bg-body-tertiary d-flex justify-content-end gap-2 py-3"><a class="btn btn-outline-secondary" asp-page="Index" asp-route-pagina="@Model.Pagina" asp-route-papel="@Model.PapelFiltro">Cancelar</a><button type="submit" class="btn btn-primary">Salvar</button></div></div></form></div></div>

