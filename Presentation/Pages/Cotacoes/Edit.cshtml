@page "{id:guid}"
@model Presentation.Pages.Cotacoes.EditModel

@{
    ViewData["Title"] = "Editar cotação";
}

<h1 class="h3">Editar cotação</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="Pagina" type="hidden" />
    <input asp-for="PapelFiltro" type="hidden" />

    <div class="mb-3">
        <label asp-for="Input.Papel" class="form-label">Papel</label>
        <input asp-for="Input.Papel" class="form-control" />
        <span asp-validation-for="Input.Papel" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Valor" class="form-label">Valor</label>
        <input asp-for="Input.Valor" class="form-control" type="number" step="0.0001" min="0.0001" />
        <span asp-validation-for="Input.Valor" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Data" class="form-label">Data</label>
        <input asp-for="Input.Data" class="form-control" type="date" />
        <span asp-validation-for="Input.Data" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-outline-secondary" asp-page="Index" asp-route-pagina="@Model.Pagina" asp-route-papel="@Model.PapelFiltro">Cancelar</a>
</form>

