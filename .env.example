# USO OPCIONAL. Se estas variáveis já estão exportadas no seu shell (por exemplo, no ~/.zshrc),
# este arquivo não é necessário. Para usá-lo: copie para .env e preencha.
# O .env real é ignorado pelo git e pelo build das imagens, e é lido pelo Docker Compose
# (não pelos containers nem pelo dotnet run).
# Variáveis exportadas no shell têm precedência sobre este arquivo: use uma única fonte.
# Evite o caractere $ nos valores (o compose o interpreta).

# --- Obrigatórias: o compose aborta se alguma estiver vazia ---
VAULT_DB_ROOT=
VAULT_DB_NAME=
VAULT_DB_USER=
VAULT_DB_PASS=

# Chave de assinatura dos tokens JWT (somente a Api a recebe). Gere uma aleatória:
#   openssl rand -base64 48
JWT_SECRET=

# --- Opcionais (valores padrão entre parênteses) ---
# VAULT_WEB_PORT=5000    # porta do Web em 127.0.0.1
# DBMAJORVERSION=12      # versão do MariaDB, usada pelo provider do EF
# DBMINORVERSION=3
# DBBUILDVERSION=3
